#!/bin/zsh

set -euo pipefail
umask 077

RUNTIME_DIR="${QWEN_MEETING_RUNTIME:-${XDG_CONFIG_HOME:-$HOME/.config}/qwen-meeting/runtime}"
STATE_DIR="${QWEN_MEETING_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/qwen-meeting}"
NIX_USER_BIN="/etc/profiles/per-user/$(/usr/bin/id -un)/bin"

export PATH="$NIX_USER_BIN:/run/current-system/sw/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"

if [[ "$(uname -s)" != Darwin || "$(uname -m)" != arm64 ]]; then
  echo "Fehler: mlx-qwen3-asr benötigt einen Apple-Silicon-Mac." >&2
  exit 1
fi

PYTHON="${QWEN_MEETING_PYTHON:-}"
ASR="${QWEN_MEETING_ASR:-}"
if [[ ! -x "$PYTHON" || ! -x "$ASR" ]]; then
  echo "Fehler: Die Nix-Laufzeit fehlt. Bitte die Konfiguration anwenden und den installierten Helfer verwenden." >&2
  exit 3
fi

if [[ ! -f "$RUNTIME_DIR/fetch-models.py" ]]; then
  echo "Fehler: Laufzeitdatei fehlt: $RUNTIME_DIR/fetch-models.py" >&2
  echo "Bitte zuerst die Nix-Darwin-Konfiguration anwenden." >&2
  exit 4
fi

if [[ -L "$STATE_DIR" || ( -e "$STATE_DIR" && ! -d "$STATE_DIR" ) ]]; then
  echo "Fehler: Das Qwen-Statusverzeichnis ist kein sicheres Verzeichnis." >&2
  exit 5
fi
if [[ -d "$STATE_DIR" && "$(/usr/bin/stat -f '%Lp' "$STATE_DIR")" != 700 ]]; then
  echo "Fehler: Das Qwen-Statusverzeichnis ist nicht privat (erwartet: Modus 700)." >&2
  echo "Bitte die Rechte bewusst manuell mit chmod 700 korrigieren." >&2
  exit 5
fi

/bin/mkdir -p "$STATE_DIR"
if [[ "$(/usr/bin/stat -f '%Lp' "$STATE_DIR")" != 700 ]]; then
  echo "Fehler: Das Qwen-Statusverzeichnis konnte nicht privat angelegt werden." >&2
  exit 5
fi

echo "Lade die revisionsgesperrten Modelle in den privaten lokalen Cache."
"$PYTHON" "$RUNTIME_DIR/fetch-models.py" --state-dir "$STATE_DIR"

echo
"$ASR" --doctor

echo
echo "Qwen3-ASR ist eingerichtet. Transkriptionsläufe bleiben vollständig offline."
echo "Beispiel: qwen-meeting \"/Pfad/zur/Aufnahme.m4a\""
