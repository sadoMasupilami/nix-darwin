#!/bin/bash

set -euo pipefail
umask 077

tmp_root=${TMPDIR:-/tmp}
tmp_root=${tmp_root%/}
work_dir=$(/usr/bin/mktemp -d "$tmp_root/nix-homebrew-preflight.XXXXXX")
/bin/chmod 700 "$work_dir"

cleanup() {
  /bin/rm -rf -- "$work_dir"
}
# The signal traps run once the foreground brew has exited, so its private
# directory is never removed under it; they then end the wrapper with the
# conventional 128+signal status, and the EXIT trap cleans up exactly once.
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

library="$work_dir/Library"
/bin/mkdir -p \
  "$library/.homebrew-is-managed-by-nix/.git" \
  "$work_dir/cache" \
  "$work_dir/config" \
  "$work_dir/logs" \
  "$work_dir/tmp"
/usr/bin/touch "$library/.homebrew-is-managed-by-nix/.git/HEAD"
/bin/ln -s "@brewCode@" "$library/Homebrew"
/bin/ln -s "@taps@" "$library/Taps"

# Read the installed Cellar/Caskroom from the real prefix, but keep Homebrew's
# code, taps, configuration, cache, logs and temporary files in locked or
# private disposable locations. The preflight's commands mutate nothing under
# /opt/homebrew; only nix-config-apply's explicitly approved `bundle cleanup
# --force` removes packages through this wrapper.
export NIX_HOMEBREW_PREFLIGHT_LIBRARY="$library"
export XDG_CONFIG_HOME="$work_dir/config"
export TMPDIR="$work_dir/tmp"
export HOMEBREW_CACHE="$work_dir/cache"
export HOMEBREW_LOGS="$work_dir/logs"
export HOMEBREW_TEMP="$work_dir/tmp"
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_NO_INSTALL_FROM_API=1
# The read-only tap check uses `brew ruby`. Keep its developer-command marker
# disposable too, without a misleading warning or a git-config write.
export HOMEBREW_DEV_CMD_RUN=1
# mas 7 otherwise invokes mdimport while merely checking Bundle state. Keep
# the promised preflight read-only; a real activation may still index/install.
export MAS_NO_AUTO_INDEX=1

# The disposable library contains only the four locked declarative taps. Seed
# the disposable config with the explicit tap trust entries that activation
# will persist, instead of reading or writing the real trust database. Formula
# and cask definitions are loaded exclusively from those pinned local checkouts.
/bin/mkdir -p "$work_dir/config/homebrew"
/bin/cp "@trustStore@" "$work_dir/config/homebrew/trust.json"
/bin/chmod 600 "$work_dir/config/homebrew/trust.json"

# nix-homebrew 0.3.1's upstream patch still targets the pre-6.0 assignment
# layout in brew.sh. Seed the exact locked version explicitly so Homebrew does
# not fall back to its generic "shallow or no git repository" label.
export HOMEBREW_VERSION="@brewVersion@"

"@innerWrapper@" "$@"
